  <string name="preload_pages">Preload pages</string>
  <string name="preload_pages_summary">Warms up and quietly fetches the page you are most likely to open next while you type, so it appears instantly. Only for addresses you type or sites in your history, never in private tabs.</string>
  <string name="site_icons">Show site icons</string>
  <string name="site_icons_summary">Use each site\'s own logo on the home page. Icons from pages you visit are free; the rest are fetched from the site itself, never from a favicon service.</string>
  <string name="cookie_popups">Answer cookie pop-ups</string>
  <string name="cookie_popups_summary">Picks the most private option on consent banners and hides them. Never accepts on your behalf.</string>
  <string name="block_fingerprinting">Resist fingerprinting</string>
  <string name="block_fingerprinting_summary">Adds imperceptible noise to canvas, audio and WebGL readings, which are otherwise identical every time and identify your device.</string>
  <string name="trim_referrers">Trim referrers</string>
  <string name="trim_referrers_summary">Tells sites which site you came from, but never which page.</string>
