  <string name="tor_safest">Safest</string>
  <string name="tor_safest_summary">Tor Browser\'s strictest level: JavaScript off and web fonts blocked on every Tor page. Many sites stop working; the ones that do reveal the least.</string>
  <string name="tor_bridges">Bridges</string>
  <string name="tor_bridges_title">Use a bridge</string>
  <string name="tor_bridges_explainer">Where Tor itself is blocked, a bridge is an unlisted first relay reached through traffic disguised as something else. Pick the kind your network lets through; the built-in bridges are the ones Tor Browser ships. Tor restarts when this changes.</string>
