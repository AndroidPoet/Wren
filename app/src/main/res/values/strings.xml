  <string name="https_upgrade">Upgrade to HTTPS</string>
  <string name="https_only">HTTPS-only mode</string>
  <string name="https_only_summary">Refuses unencrypted pages and mixed content outright instead of falling back. Sites you excuse on the error screen stay allowed until you close Wren.</string>
  <string name="https_only_blocked_page" translatable="false"><![CDATA[<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Blocked</title><style>body{font-family:sans-serif;margin:0;padding:48px 24px;background:#fbf7f1;color:#2b2320}h1{font-size:20px;margin:0 0 12px}p{line-height:1.5;color:#5a4e48}code{word-break:break-all}</style></head><body><h1>Insecure connection refused</h1><p>HTTPS-only mode is on, and <code>%1$s</code> was asked for over plain HTTP. Nothing was sent.</p><p>To allow this site for the rest of the session, open it from the address bar and choose to continue on its error screen, or turn HTTPS-only mode off in Settings.</p></body></html>]]></string>
  <string name="https_upgrade_summary">Try an encrypted connection first and fall back only if the site cannot serve one.</string>
