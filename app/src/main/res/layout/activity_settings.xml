<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/ground"
  android:orientation="vertical">

  <com.google.android.material.appbar.MaterialToolbar
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@color/layer"
    app:navigationIcon="@drawable/ic_arrow_back"
    app:title="@string/settings"
    app:titleTextColor="@color/ink" />

  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="20dp"
      android:paddingEnd="20dp"
      android:paddingBottom="24dp">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:paddingBottom="4dp"
        android:text="@string/section_search"
        android:textColor="@color/russet_strong"
        android:textSize="13sp"
        android:textStyle="bold" />

      <LinearLayout
        android:id="@+id/searchEngineRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:minHeight="56dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/search_engine"
          android:textColor="@color/ink"
          android:textSize="15sp" />

        <TextView
          android:id="@+id/searchEngineValue"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textAppearance="@style/TextAppearance.Wren.Caption" />
      </LinearLayout>

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/remoteSuggestionsSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/remote_suggestions"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/remote_suggestions_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:paddingBottom="4dp"
        android:text="@string/section_appearance"
        android:textColor="@color/russet_strong"
        android:textSize="13sp"
        android:textStyle="bold" />

      <LinearLayout
        android:id="@+id/themeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:minHeight="56dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/theme"
          android:textColor="@color/ink"
          android:textSize="15sp" />

        <TextView
          android:id="@+id/themeValue"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textAppearance="@style/TextAppearance.Wren.Caption" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/textSizeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:minHeight="56dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/text_size"
          android:textColor="@color/ink"
          android:textSize="15sp" />

        <TextView
          android:id="@+id/textSizeValue"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textAppearance="@style/TextAppearance.Wren.Caption" />
      </LinearLayout>

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/darkenWebPagesSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/darken_web_pages"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/darken_web_pages_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/bottomBarSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/bottom_address_bar"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/bottom_address_bar_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <LinearLayout
        android:id="@+id/orientationRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:minHeight="56dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/orientation"
          android:textColor="@color/ink"
          android:textSize="15sp" />

        <TextView
          android:id="@+id/orientationValue"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textAppearance="@style/TextAppearance.Wren.Caption" />
      </LinearLayout>

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/keepScreenOnSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/keep_screen_on"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:paddingBottom="4dp"
        android:text="@string/section_content"
        android:textColor="@color/russet_strong"
        android:textSize="13sp"
        android:textStyle="bold" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/javascriptSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/javascript"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/javascript_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/preloadPagesSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/preload_pages"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/preload_pages_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/siteIconsSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/site_icons"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/site_icons_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/dataSaverSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/data_saver"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/data_saver_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/desktopModeSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/desktop_mode"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/desktop_mode_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:paddingBottom="4dp"
        android:text="@string/section_tor"
        android:textColor="@color/russet_strong"
        android:textSize="13sp"
        android:textStyle="bold" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/torModeSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/tor_mode"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/tor_mode_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:paddingBottom="4dp"
        android:text="@string/section_privacy"
        android:textColor="@color/russet_strong"
        android:textSize="13sp"
        android:textStyle="bold" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/blockAdsSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/block_ads"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/block_ads_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <LinearLayout
        android:id="@+id/filterListRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:minHeight="56dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/filter_list"
          android:textColor="@color/ink"
          android:textSize="15sp" />

        <TextView
          android:id="@+id/filterListValue"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textAppearance="@style/TextAppearance.Wren.Caption" />
      </LinearLayout>

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/cookiePopupsSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/cookie_popups"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/cookie_popups_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/fingerprintingSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/block_fingerprinting"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/block_fingerprinting_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/trimReferrersSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/trim_referrers"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/trim_referrers_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/httpsOnlySwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/https_only"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/https_only_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/httpsUpgradeSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/https_upgrade"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/https_upgrade_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/stripTrackingSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/strip_tracking_parameters"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/strip_tracking_parameters_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/thirdPartyCookiesSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/block_third_party_cookies"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/block_third_party_cookies_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/doNotTrackSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/do_not_track"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/do_not_track_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/recordHistorySwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/record_history"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/record_history_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/clearOnExitSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/clear_on_exit"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/clear_on_exit_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/appLockSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/app_lock"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/app_lock_summary"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:paddingBottom="4dp"
        android:text="@string/section_data"
        android:textColor="@color/russet_strong"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/exportBookmarksRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:text="@string/export_bookmarks"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:id="@+id/importBookmarksRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:text="@string/import_bookmarks"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:id="@+id/backupDataRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:text="@string/backup_data"
        android:textColor="@color/ink"
        android:textSize="15sp" />

      <TextView
        android:id="@+id/restoreDataRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:text="@string/restore_data"
        android:textColor="@color/ink"
        android:textSize="15sp" />
    </LinearLayout>
  </ScrollView>
</LinearLayout>
