<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/errorRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/ground"
  android:clickable="true"
  android:focusable="true"
  android:gravity="center"
  android:orientation="vertical"
  android:paddingStart="32dp"
  android:paddingEnd="32dp">

  <ImageView
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:contentDescription="@null"
    android:src="@drawable/ic_unreachable" />

  <TextView
    android:id="@+id/errorTitle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:gravity="center"
    android:text="@string/error_title"
    android:textColor="@color/ink"
    android:textSize="20sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/errorHost"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:ellipsize="middle"
    android:gravity="center"
    android:maxLines="1"
    android:textColor="@color/ink_soft"
    android:textSize="15sp" />

  <TextView
    android:id="@+id/errorReason"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:gravity="center"
    android:lineSpacingExtra="3dp"
    android:maxWidth="320dp"
    android:textColor="@color/ink_faint"
    android:textSize="14sp" />

  <com.google.android.material.button.MaterialButton
    android:id="@+id/errorRetry"
    style="@style/Widget.MaterialComponents.Button"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="28dp"
    android:backgroundTint="@color/russet"
    android:minWidth="160dp"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:text="@string/error_retry"
    android:textAllCaps="false"
    android:textColor="@color/on_accent" />
</LinearLayout>
