<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/ground"
  android:defaultFocusHighlightEnabled="false"
  android:descendantFocusability="beforeDescendants"
  android:focusable="true"
  android:focusableInTouchMode="true">

  <LinearLayout
    android:id="@+id/browserChrome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
      android:id="@+id/topBar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/layer"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="8dp"
      android:paddingTop="6dp"
      android:paddingEnd="8dp"
      android:paddingBottom="6dp">

      <TextView
        android:id="@+id/torPill"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_badge_tor"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/ic_tor"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="10dp"
        android:text="@string/tor"
        android:textColor="@color/moss"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

      <LinearLayout
        android:id="@+id/omniboxContainer"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/bg_omnibox"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <ImageView
          android:id="@+id/securityIcon"
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:contentDescription="@string/page_security"
          android:src="@drawable/ic_search" />

        <EditText
          android:id="@+id/omnibox"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:background="@null"
          android:hint="@string/search_or_type_url"
          android:imeOptions="actionGo|flagNoExtractUi|flagNoPersonalizedLearning"
          android:inputType="textUri|textNoSuggestions"
          android:maxLines="1"
          android:paddingStart="10dp"
          android:paddingEnd="4dp"
          android:selectAllOnFocus="true"
          android:textColor="@color/ink"
          android:textColorHint="@color/ink_faint"
          android:textSize="15sp" />

        <ImageView
          android:id="@+id/omniboxAction"
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="@string/reload"
          android:padding="8dp"
          android:src="@drawable/ic_refresh" />
      </LinearLayout>
    </LinearLayout>

    <ProgressBar
      android:id="@+id/progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="2dp"
      android:max="100"
      android:progressDrawable="@drawable/progress_page"
      android:visibility="gone" />

    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1">

      <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
          android:id="@+id/webViewContainer"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@color/ground" />
      </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

      <ImageView
        android:id="@+id/tabSnapshot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone" />

      <include
        android:id="@+id/home"
        layout="@layout/view_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

      <include
        android:id="@+id/error"
        layout="@layout/view_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/suggestionList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/layer"
        android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
      android:id="@+id/findBar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/sheet"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="16dp"
      android:paddingEnd="4dp"
      android:visibility="gone">

      <EditText
        android:id="@+id/findInput"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@null"
        android:hint="@string/find_hint"
        android:imeOptions="actionSearch|flagNoExtractUi|flagNoPersonalizedLearning"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink_faint"
        android:textSize="15sp" />

      <TextView
        android:id="@+id/findCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="46dp"
        android:gravity="center"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />

      <ImageView
        android:id="@+id/findPrevious"
        style="@style/Widget.Wren.IconButton"
        android:contentDescription="@string/find_previous"
        android:rotation="90"
        android:src="@drawable/ic_arrow_back" />

      <ImageView
        android:id="@+id/findNext"
        style="@style/Widget.Wren.IconButton"
        android:contentDescription="@string/find_next"
        android:rotation="90"
        android:src="@drawable/ic_arrow_forward" />

      <ImageView
        android:id="@+id/findClose"
        style="@style/Widget.Wren.IconButton"
        android:contentDescription="@string/find_close"
        android:src="@drawable/ic_close" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/layer"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingTop="4dp"
      android:paddingBottom="4dp">

      <ImageView
        android:id="@+id/backButton"
        style="@style/Widget.Wren.IconButton"
        android:layout_weight="1"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_arrow_back" />

      <ImageView
        android:id="@+id/forwardButton"
        style="@style/Widget.Wren.IconButton"
        android:layout_weight="1"
        android:contentDescription="@string/forward"
        android:src="@drawable/ic_arrow_forward" />

      <ImageView
        android:id="@+id/homeButton"
        style="@style/Widget.Wren.IconButton"
        android:layout_weight="1"
        android:contentDescription="@string/home"
        android:src="@drawable/ic_home" />

      <TextView
        android:id="@+id/tabsButton"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_tab_count"
        android:contentDescription="@string/tabs"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

      <ImageView
        android:id="@+id/burnButton"
        style="@style/Widget.Wren.IconButton"
        android:layout_weight="1"
        android:contentDescription="@string/burn"
        android:src="@drawable/ic_burn" />

      <ImageView
        android:id="@+id/menuButton"
        style="@style/Widget.Wren.IconButton"
        android:layout_weight="1"
        android:contentDescription="@string/more"
        android:src="@drawable/ic_more" />
    </LinearLayout>
  </LinearLayout>

  <FrameLayout
    android:id="@+id/customViewContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:visibility="gone" />
</FrameLayout>
