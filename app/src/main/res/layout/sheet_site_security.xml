<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@color/layer"
  android:maxHeight="520dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <TextView
      android:id="@+id/securityHost"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="middle"
      android:maxLines="1"
      android:textColor="@color/ink"
      android:textSize="17sp"
      android:textStyle="bold" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/securityConnectionIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_lock" />

      <TextView
        android:id="@+id/securityConnection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/ink_soft"
        android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/certificateGroup"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:orientation="vertical">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/certificate"
        android:textColor="@color/russet_strong"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/certificate_issued_to"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <TextView
        android:id="@+id/certificateIssuedTo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textColor="@color/ink"
        android:textSize="14sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/certificate_issued_by"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />

      <TextView
        android:id="@+id/certificateIssuedBy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textColor="@color/ink"
        android:textSize="14sp" />

      <TextView
        android:id="@+id/certificateValidity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Wren.Caption" />
    </LinearLayout>

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="22dp"
      android:paddingBottom="8dp"
      android:text="@string/section_privacy"
      android:textColor="@color/russet_strong"
      android:textSize="13sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/trackerCount"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textColor="@color/ink"
      android:textSize="15sp" />

    <LinearLayout
      android:id="@+id/trackerGroups"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:orientation="vertical" />

    <com.google.android.material.switchmaterial.SwitchMaterial
      android:id="@+id/siteJavascriptSwitch"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:text="@string/site_javascript"
      android:textColor="@color/ink"
      android:textSize="15sp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
      android:id="@+id/siteDesktopSwitch"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:text="@string/site_desktop"
      android:textColor="@color/ink"
      android:textSize="15sp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
      android:id="@+id/siteKeepSignedInSwitch"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:text="@string/keep_signed_in"
      android:textColor="@color/ink"
      android:textSize="15sp" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/keep_signed_in_summary"
      android:textAppearance="@style/TextAppearance.Wren.Caption" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/securityBlockingAction"
      style="@style/Widget.MaterialComponents.Button.TextButton"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:textColor="@color/russet_strong" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/securityReportAction"
      style="@style/Widget.MaterialComponents.Button.TextButton"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/report_broken_site"
      android:textColor="@color/ink_faint" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
