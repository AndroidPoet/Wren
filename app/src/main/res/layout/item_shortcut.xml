<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="?attr/selectableItemBackgroundBorderless"
  android:gravity="center_horizontal"
  android:orientation="vertical"
  android:paddingTop="10dp"
  android:paddingBottom="10dp">

  <FrameLayout
    android:id="@+id/tileBackground"
    android:layout_width="@dimen/tile_size"
    android:layout_height="@dimen/tile_size">

    <TextView
      android:id="@+id/tileLetter"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:textColor="@color/tile_letter"
      android:textSize="24sp"
      android:textStyle="bold" />

    <ImageView
      android:id="@+id/tileIcon"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:layout_gravity="center"
      android:contentDescription="@null"
      android:visibility="gone" />

    <ImageView
      android:id="@+id/tileAdd"
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_gravity="center"
      android:contentDescription="@string/add_shortcut"
      android:src="@drawable/ic_add"
      android:visibility="gone" />
  </FrameLayout>

  <TextView
    android:id="@+id/tileLabel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:ellipsize="end"
    android:gravity="center"
    android:maxLines="1"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:textColor="@color/ink_soft"
    android:textSize="12sp" />
</LinearLayout>
